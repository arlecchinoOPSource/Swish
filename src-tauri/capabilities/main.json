{
  "identifier": "main",
  "description": "The main window may only read and write Swish's own projects and reminders through the listed app commands.",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-load-workspace",
    "allow-create-project",
    "allow-update-project",
    "allow-create-reminder",
    "allow-update-reminder",
    "allow-set-reminder-completed",
    "allow-delete-project",
    "allow-delete-reminder",
    "allow-restore-reminder",
    "allow-export-backup",
    "allow-inspect-backup",
    "allow-cancel-restore",
    "allow-restore-backup",
    "allow-undo-restore"
  ]
}
